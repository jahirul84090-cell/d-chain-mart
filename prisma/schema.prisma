generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  password                String?
  name                    String?
  role                    Role      @default(USER)
  isBlocked               Boolean   @default(false)
  image                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  accounts                Account[]
  sessions                Session[]
  addresses               Address[]
  orders                  Order[]
  cart                    Cart?
  wishlist                Wishlist?
  reviews                 Review[]
  googleId                String?   @unique
  emailVerified           Boolean   @default(false)
  otpCode                 String?
  otpExpiresAt            DateTime?
  otpAttempts             Int       @default(0)
  lastSessionInvalidation DateTime?

  loanApplications        LoanApplication[]
  inventoryProducts InventoryProduct[] @relation("InventoryOwner")
inventorySales    InventorySale[]    @relation("InventorySaleOwner")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  imageUrl String?

  products Product[]
}

model Review {
  id          String   @id @default(uuid())
  productId   String
  userId      String
  rating      Int      @default(5) @db.SmallInt
  title       String?  @db.VarChar(100)
  content     String
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images      ReviewImage[]
  product     Product  @relation(fields: [productId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId, userId])
}

model ReviewImage {
  id        String   @id @default(uuid())
  reviewId  String
  url       String
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [id])

  @@index([reviewId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String
  productId     String
  quantity      Int
  selectedSize  String?
  selectedColor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])

  @@index([cartId])
  @@index([productId])
}

model Wishlist {
  id       String    @id @default(uuid())
  userId   String    @unique

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[] @relation(name: "ProductOnWishlist")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Product {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  shortdescription String?  @db.Text
  description      String?  @db.Text
  price            Float
  buyingPrice      Float    @default(0)
  stockAmount      Int      @default(0)

  availableSizes   String?
  availableColors  String?

  isFeatured       Boolean  @default(false)
  isPopular        Boolean  @default(false)
  isNewArrival     Boolean  @default(false)
  isSlider         Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  mainImage        String
  isActive         Boolean  @default(true)

  images           ProductImage[]
  reviews          Review[]
  wishlists        Wishlist[] @relation(name: "ProductOnWishlist")
  orderItems       OrderItem[]
  cartItems        CartItem[]
  loanApplications LoanApplication[]
  stockLedgers     StockLedger[]

  totalSales       Float    @default(0)
  views            Float    @default(0)
  oldPrice         Float    @default(0)
  discount         Float    @default(0)

  @@index([categoryId])
  @@index([isActive, createdAt])
  @@index([isActive, isFeatured])
  @@index([isActive, isNewArrival])
  @@index([isActive, totalSales])
  @@index([isActive, price])
}

model Order {
  id                 String      @id @default(uuid())
  userId             String
  orderTotal         Float
  deliveryFee        Float       @default(0)
  shippingAddressId  String
  status             OrderStatus @default(PENDING)
  paymentMethodId    String?
  transactionNumber  String      @unique
  isPaid             Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  isInvoiceGenerated Boolean     @default(false)

  invoice            Invoice?
  user               User        @relation(fields: [userId], references: [id])
  shippingAddress    Address     @relation(fields: [shippingAddressId], references: [id])
  items              OrderItem[]
  paymentMethod      PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  loanApplications   LoanApplication[]

  @@index([userId])
  @@index([shippingAddressId])
  @@index([paymentMethodId])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String
  productSnapshot Json
  quantity        Int
  pricePaid       Float

  buyingPrice     Float    @default(0)
  sellingPrice    Float    @default(0)
  totalCost       Float    @default(0)
  totalRevenue    Float    @default(0)
  totalProfit     Float    @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order           Order    @relation(fields: [orderId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([orderId, productId])
}

model DeliveryFee {
  id        String   @id @default(uuid())
  city      String?
  country   String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([country, city])
}

model PaymentMethod {
  id               String   @id @default(uuid())
  name             String   @unique
  accountNumber    String?
  instructions     String?
  isCashOnDelivery Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders           Order[]
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  createdAt     DateTime @default(now())
  invoiceUrl    String

  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  street      String
  city        String
  state       String?
  zipCode     String?
  country     String
  phoneNumber String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  orders      Order[]

  @@index([userId])
}

model Media {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(255)
  title     String?  @db.VarChar(255)
  altText   String?  @db.VarChar(255)
  createdAt DateTime @default(now())
}

enum LoanStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  DOWN_PAYMENT_PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum LoanDocumentType {
  NID_FRONT
  NID_BACK
  SELFIE
  NOMINEE_PHOTO
  SALARY_PROOF
  BANK_STATEMENT
  OTHER
}

enum LoanPaymentType {
  DOWN_PAYMENT
  INSTALLMENT
  LATE_FEE
  REFUND
  OTHER
}

enum LoanPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

model LoanApplication {
  id                 String     @id @default(uuid())

  userId             String
  productId          String
  orderId            String?    @unique

  productPrice       Float
  productBuyingPrice Float      @default(0)

  downPayment        Float
  downPaymentPaid    Float      @default(0)

  loanAmount         Float
  interestRate       Float      @default(0)
  tenureMonths       Int
  monthlyEmi         Float
  totalPayable       Float

  productProfit      Float      @default(0)
  interestProfit     Float      @default(0)
  expectedProfit     Float      @default(0)

  firstEmiDelayDays  Int        @default(30)
  gracePeriodDays    Int        @default(3)
  lateFee            Float      @default(0)

  status             LoanStatus @default(PENDING)

  appliedAt          DateTime   @default(now())
  approvedAt         DateTime?
  rejectedAt         DateTime?
  loanStartDate      DateTime?
  firstDueDate       DateTime?

  applicantName      String?
  applicantAddress   String?    @db.Text

  nidNumber          String?
  monthlyIncome      Float?
  jobType            String?
  customerNote       String?    @db.Text
  adminNote          String?    @db.Text

  nomineeName        String?
  nomineeRelation    String?
  nomineePhone       String?
  nomineeAddress     String?    @db.Text

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user               User       @relation(fields: [userId], references: [id])
  product            Product    @relation(fields: [productId], references: [id])
  order              Order?     @relation(fields: [orderId], references: [id])

  installments       InstallmentPayment[]
  documents          LoanDocument[]
  payments           LoanPayment[]

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([appliedAt])
}

model InstallmentPayment {
  id                String            @id @default(uuid())
  loanApplicationId String

  installmentNo     Int
  dueDate           DateTime
  originalDueDate   DateTime?

  amount            Float
  paidAmount        Float             @default(0)
  remainingAmount   Float             @default(0)
  lateFee           Float             @default(0)

  status            InstallmentStatus @default(UNPAID)

  paidAt            DateTime?
  note              String?           @db.Text

  isDateChanged     Boolean           @default(false)
  dateChangedReason String?           @db.Text

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  loanApplication   LoanApplication   @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  payments          LoanPayment[]

  @@index([loanApplicationId])
  @@index([dueDate])
  @@index([status])
}

model LoanPayment {
  id                String            @id @default(uuid())

  loanApplicationId String
  installmentId     String?

  paymentType       LoanPaymentType
  status            LoanPaymentStatus @default(PENDING)

  amount            Float

  paymentMethod     String?
  transactionNumber String?
  referenceNumber   String?
  receivedBy        String?

  paidAt            DateTime?
  note              String?           @db.Text

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  loanApplication   LoanApplication   @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  installment       InstallmentPayment? @relation(fields: [installmentId], references: [id])

  @@index([loanApplicationId])
  @@index([installmentId])
  @@index([paymentType])
  @@index([status])
  @@index([paidAt])
}

model LoanDocument {
  id                String           @id @default(uuid())
  loanApplicationId String
  type              LoanDocumentType
  url               String
  title             String?
  createdAt         DateTime         @default(now())

  loanApplication   LoanApplication  @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  @@index([loanApplicationId])
}

model LoanSetting {
  id                String   @id @default(uuid())

  minDownPaymentPct Float    @default(0)
  defaultInterest   Float    @default(10)
  defaultTenure     Int      @default(12)
  firstEmiDelayDays Int      @default(30)
  gracePeriodDays   Int      @default(3)
  lateFee           Float    @default(100)

  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum StockLedgerType {
  STOCK_IN
  STOCK_OUT
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT
}

model StockLedger {
  id        String          @id @default(uuid())
  productId String
  type      StockLedgerType
  quantity  Int
  note      String?         @db.Text
  createdAt DateTime        @default(now())

  product   Product         @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model Expense {
  id        String   @id @default(uuid())
  title     String
  amount    Float
  category  String?
  note      String?  @db.Text
  expenseAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseAt])
  @@index([category])
}







model InventoryProduct {
  id        String   @id @default(uuid())
  ownerId   String

  brandName String   @db.VarChar(100)
  model     String   @db.VarChar(100)
  variant   String?  @db.VarChar(100)

  buyPrice  Float
  sellPrice Float
  stock     Int      @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation("InventoryOwner", fields: [ownerId], references: [id])
  sales InventorySale[]

  @@index([ownerId])
  @@index([isActive])
}

model InventorySale {
  id        String @id @default(uuid())
  productId String
  ownerId   String

  qty       Int
  sellPrice Float
  buyPrice  Float
  profit    Float

  month     Int
  year      Int
  note      String? @db.VarChar(255)

  createdAt DateTime @default(now())

  product InventoryProduct @relation(fields: [productId], references: [id])
  owner   User             @relation("InventorySaleOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([productId])
  @@index([month, year])
}